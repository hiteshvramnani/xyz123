# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (PostGIS)
DATABASE_URL=postgresql://dc_user:dc_password_dev@localhost:5432/data_collection

# JWT (for service tokens)
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY=24h

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password_dev
S3_BUCKET=data-collection-media
S3_FORCE_PATH_STYLE=true

# File upload limits (bytes)
MEDIA_MAX_IMAGE=10485760
MEDIA_MAX_VIDEO=524288000
MEDIA_MAX_AUDIO=52428800
MEDIA_MAX_DOCUMENT=26214400
MEDIA_MAX_SCREENSHOT=10485760

# Pagination
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
